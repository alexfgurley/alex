import numpy as np
# 3.1 1D NumPy Arrays
list = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35] 
arr = np.array(list)
print(arr) 


print(arr * 4)


print(np.mean(arr))


print(np.median(arr)) 
print(np.std(arr)) 


print(arr[np.argmin(arr)], arr[np.argmax(arr)]) 


print(np.min(arr), np.max(arr)) #matches the values from previous step


arr_20 = arr[arr > 20]
print(arr_20)


# 3.2 2D NumPy Arrays
list = [
[5, 12, 17, 9],
[8, 21, 14, 3],
[6, 13, 19, 11]
]
matrix = np.array(list)
print(np.shape(matrix)) # --> 3 rows and 4 columns


print(matrix[:, 2]) 


print(matrix[2, :])


print(matrix * 2) 


for x in range(0,3)  : 
    print(np.mean(matrix[:, x])) 


print(np.mean(matrix))


for x in range(0, 3) : 
    print(f" row {x} has max value {np.max(matrix[x, :])}")
for x in range(0,4) : 
    print(f" col {x} has min value {np.min(matrix[:, x])}")


print(matrix.flatten()) # new shape is a single row matrix with all of the entries


print(np.argmin(matrix.flatten()), np.argmax(matrix.flatten()))


np.unravel.index(matrix)



