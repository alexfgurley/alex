#  Prime Star Systems
arr_mag = np.array([
[2, 3, 5],
[14, 6, 8],
[11, 13, 17],
[7, 10, 13]
])

def sort_prime(array) :
    prime_arr = ([])
    prime = False
    
    for row in array :
        
        for x in row :
            prime = True
            
            if x <= 1 : 
                prime = False
                
            for i in range(2, x) : 
                if x % i == 0 :
                    prime = False
                    break 
                    
        for x in row :
            
            if prime == True : 
                prime_arr.append(row)     
                break
            
    return np.array(prime_arr)

print(sort_prime(arr_mag)) 


